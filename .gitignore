# 依赖
node_modules/
*/node_modules/

# 打包产物
dist/
client/dist/
*.exe
*.exe.blockmap

# 运行期数据（房间存档不进版本库）
server/data/

# 安卓端内嵌状态机（tools/sync-android-core.js 的生成物，来源是 server/src）
client/renderer/local-core/
# 安卓工程（Capacitor 平台目录 + 构建产物）
client-android/android/app/build/
client-android/android/.gradle/
client-android/android/build/
client-android/*.keystore

# 测试/探针产物
screenshots/
tools/_*
tools/bin/
*.log
# 有些用例把房间存档直接落在仓库根目录（相对路径没写全时就会这样），别带进版本库
.tmp-rooms-*/

# 介绍视频的中间产物（成片太大也不进库；video/README.md 例外）
video/*
!video/README.md

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 备份
