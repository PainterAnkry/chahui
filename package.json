{
  "name": "chahui",
  "version": "1.3.9",
  "private": true,
  "description": "茶绘 · 多人实时协作绘画聊天室（桌面端 + 公网服务端，SAI2 风格笔刷体系）",
  "scripts": {
    "sync": "node tools/sync-protocol.js && node tools/sync-server.js && node tools/sync-web.js",
    "server": "node server/src/index.js",
    "expose": "node tools/expose.js",
    "client": "npm --prefix client start",
    "check": "node tools/check-css.js client/renderer/styles.css && node tools/check-defs.js",
    "test": "node tools/test-clients.js",
    "test:browser": "node tools/test-browser.js",
    "test:public": "node tools/test-public.js",
    "verify": "node tools/verify-issues.js",
    "verify2": "node tools/verify-round2.js",
    "verify3": "node tools/verify-round3.js",
    "brushes": "node tools/brush-metrics.js",
    "brush-sheet": "node tools/brush-sheet.js",
    "rooms": "node tools/rooms-admin.js",
    "shots": "node tools/shots-readme.js",
    "shots:lan": "node tools/shots-lan.js",
    "dist": "npm run sync && npm --prefix client run dist",
    "test:stroke": "node tools/test-stroke.js",
    "test:embed": "node tools/test-embed.js",
    "test:lan": "node tools/test-lan.js",
    "test:selection": "node tools/test-selection.js",
    "test:transform": "node tools/test-transform-buttons.js",
    "test:overlay": "node tools/test-overlay.js",
    "test:import": "node tools/test-brush-import.js",
    "test:menu": "node tools/test-menu.js",
    "abr:corpus": "node tools/abr-corpus.js",
    "test:wheel": "node tools/test-wheel.js",
    "test:feel": "node tools/test-brush-feel.js",
    "test:shell": "node tools/test-shell.js",
    "test:mesh": "node tools/test-mesh.js",
    "test:filters": "node tools/test-filters.js",
    "test:export": "node tools/test-export.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PainterAnkry/chahui.git"
  },
  "author": "Ankry",
  "keywords": [
    "drawing",
    "collaborative",
    "canvas",
    "sai",
    "websocket",
    "electron"
  ],
  "optionalDependencies": {
    "playwright-core": "^1.49.0"
  }
}
